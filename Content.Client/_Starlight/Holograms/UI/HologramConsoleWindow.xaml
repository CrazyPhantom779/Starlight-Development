<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:ui="clr-namespace:Content.Client._Starlight.Holograms.UI"
               Title="{Loc 'hologram-console-window-title'}"
               MinSize="1040 700"
               SetSize="1160 780"
               Resizable="True">

    <PanelContainer StyleClasses="PdaBackground" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="12">

            <!-- Header -->
            <PanelContainer>
                <BoxContainer Orientation="Horizontal" Margin="14 11" SeparationOverride="14">
                    <!-- Accent bar -->
                    <PanelContainer Name="HeaderAccent" MinSize="4 0" VerticalExpand="True" />

                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                        <Label Text="{Loc 'hologram-console-title'}"
                               FontColorOverride="#7dd3fc" />
                        <Label Name="StatusLabel"
                               Text="{Loc 'hologram-console-status-no-blade-servers'}"
                               FontColorOverride="#94a3b8" />
                    </BoxContainer>

                    <BoxContainer Orientation="Horizontal" SeparationOverride="14" VerticalAlignment="Center">
                        <!-- Battery indicator: only visible when the console says so (see comp) -->
                        <ui:BatteryIndicator Name="HeaderBattery" VerticalAlignment="Center" />

                        <PanelContainer Name="ModeBadge">
                            <Label Name="ModeLabel"
                                   Text="{Loc 'hologram-console-mode-station'}"
                                   Margin="8 3"
                                   FontColorOverride="#fbbf24" />
                        </PanelContainer>

                        <PanelContainer Name="ActiveBadge">
                            <Label Name="ActiveIndicator"
                                   Text="● READY"
                                   Margin="8 3"
                                   FontColorOverride="#fbbf24" />
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <!-- Main layout -->
            <BoxContainer Orientation="Horizontal"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          SeparationOverride="12">

                <!-- Left rail -->
                <BoxContainer Name="LeftPanel"
                              Orientation="Vertical"
                              MinSize="410 0"
                              VerticalExpand="True"
                              SeparationOverride="10">

                    <PanelContainer>
                        <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="6">
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc 'hologram-console-section-blade-servers'}"
                                       HorizontalExpand="True"
                                       FontColorOverride="#e5e7eb" />
                                <Label Name="NoBladeServersLabel"
                                       Text="{Loc 'hologram-console-none-detected'}"
                                       FontColorOverride="#ef4444" />
                            </BoxContainer>

                            <Label Text="{Loc 'hologram-console-hint-select-blade'}"
                                   FontColorOverride="#94a3b8" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer VerticalExpand="True">
                        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" Margin="6">
                            <BoxContainer Name="BladeServersList"
                                          Orientation="Vertical"
                                          HorizontalExpand="True"
                                          VerticalExpand="True"
                                          SeparationOverride="6" />
                        </ScrollContainer>
                    </PanelContainer>

                    <PanelContainer Name="SelectedPanel">
                        <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="6">
                            <Label Text="{Loc 'hologram-console-section-selection'}"
                                   FontColorOverride="#e5e7eb" />
                            <Label Name="SelectedBladeLabel"
                                   Text="{Loc 'hologram-console-blade-none'}"
                                   ClipText="True"
                                   FontColorOverride="#94a3b8" />
                            <Label Name="SelectedProjectorLabel"
                                   Text="{Loc 'hologram-console-projector-none'}"
                                   ClipText="True"
                                   FontColorOverride="#94a3b8" />
                            <Label Name="HintLabel"
                                   Text="{Loc 'hologram-console-hint-select-both'}"
                                   FontColorOverride="#7dd3fc" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer Name="SettingsPanel">
                        <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="8">
                            <Label Text="{Loc 'hologram-console-section-settings'}"
                                   FontColorOverride="#e5e7eb" />
                            <CheckBox Name="AllowCarryCheckbox"
                                      Text="{Loc 'hologram-console-allow-carry'}" />
                            <Label Name="PortableInfoLabel"
                                   Text="{Loc 'hologram-console-active-placeholder'}"
                                   FontColorOverride="#7dd3fc" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer Name="ControlsPanel">
                        <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
                            <Button Name="ProjectButton"
                                    Text="▶ PROJECT"
                                    HorizontalExpand="True"
                                    MinSize="0 48" />
                            <Button Name="RecallButton"
                                    Text="◾ RECALL"
                                    HorizontalExpand="True"
                                    MinSize="0 44" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>

                <!-- Map / projector area -->
                <BoxContainer Name="MapPanel"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              VerticalExpand="True"
                              MinSize="690 0"
                              SeparationOverride="10">

                    <PanelContainer HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" Margin="12 10" SeparationOverride="8">
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                                <Label Text="{Loc 'hologram-console-section-map'}"
                                       FontColorOverride="#e5e7eb" />
                                <Label Text="{Loc 'hologram-console-map-hint'}"
                                       FontColorOverride="#94a3b8" />
                            </BoxContainer>
                            <Label Name="ProjectorCountLabel"
                                   Text="{Loc 'hologram-console-projector-count-placeholder'}"
                                   FontColorOverride="#7dd3fc"
                                   VerticalAlignment="Center" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer HorizontalExpand="True"
                                    VerticalExpand="True"
                                    MinSize="690 590">
                        <ui:HologramConsoleNavMapControl Name="NavMap"
                                                         HorizontalExpand="True"
                                                         VerticalExpand="True"
                                                         MinSize="690 590" />

                        <PanelContainer Name="NoServerOverlay"
                                        HorizontalExpand="True"
                                        VerticalExpand="True">
                            <BoxContainer Orientation="Vertical"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SeparationOverride="10">
                                <Label Name="NoServerMapLabel"
                                       Text="{Loc 'hologram-console-no-projectors-title'}"
                                       HorizontalAlignment="Center"
                                       FontColorOverride="#ef4444" />
                                <Label Text="{Loc 'hologram-console-no-projectors-hint'}"
                                       HorizontalAlignment="Center"
                                       FontColorOverride="#94a3b8" />
                            </BoxContainer>
                        </PanelContainer>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
