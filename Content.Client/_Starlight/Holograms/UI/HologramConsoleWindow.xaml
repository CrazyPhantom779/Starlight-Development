<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:ui="clr-namespace:Content.Client._Starlight.Holograms.UI"
               Title="Hologram Console"
               MinSize="980 680"
               SetSize="1120 760"
               Resizable="True">

    <PanelContainer StyleClasses="PdaBackground" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">

            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <Label Text="HOLOGRAM PROJECTION CONTROL"
                       HorizontalExpand="True"
                       FontColorOverride="#7dd3fc"/>
                <Label Name="ModeLabel"
                       Text="PORTABLE MODE"
                       FontColorOverride="#fbbf24"/>
                <Label Name="ActiveIndicator"
                       Text="● READY"
                       FontColorOverride="#fbbf24"/>
            </BoxContainer>

            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="10">

                <BoxContainer Name="LeftPanel"
                              Orientation="Vertical"
                              SetWidth="380"
                              VerticalExpand="True"
                              SeparationOverride="8">

                    <PanelContainer>
                        <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                            <Label Text="BLADE SERVERS" FontColorOverride="#e5e7eb"/>
                            <Label Name="StatusLabel"
                                   Text="No blade servers available"
                                   FontColorOverride="#7dd3fc"/>
                            <Label Name="NoBladeServersLabel"
                                   Text="No same-grid blade servers detected."
                                   FontColorOverride="#ef4444"/>
                        </BoxContainer>
                    </PanelContainer>

                    <ScrollContainer VerticalExpand="True">
                        <BoxContainer Name="BladeServersList"
                                      Orientation="Vertical"
                                      VerticalExpand="True"
                                      SeparationOverride="6"/>
                    </ScrollContainer>

                    <PanelContainer Name="BatteryPanel">
                        <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="BATTERY" HorizontalExpand="True"/>
                                <Label Name="BatteryLabel" Text="--%"/>
                            </BoxContainer>
                            <ProgressBar Name="BatteryBar" MinValue="0" MaxValue="1" Value="0"/>
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer Name="SettingsPanel">
                        <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                            <CheckBox Name="AllowCarryCheckbox"
                                      Text="Allow hologram carry mode"/>
                            <Label Name="PortableInfoLabel"
                                   Text="Active: 0 / 0"
                                   FontColorOverride="#7dd3fc"/>
                        </BoxContainer>
                    </PanelContainer>

                    <BoxContainer Name="ControlsPanel" Orientation="Vertical" SeparationOverride="8">
                        <Button Name="ProjectButton"
                                Text="▶ PROJECT"
                                MinSize="340 55"/>
                        <Button Name="RecallButton"
                                Text="◾ RECALL"
                                MinSize="340 55"/>
                    </BoxContainer>
                </BoxContainer>

                <BoxContainer Name="MapPanel"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              VerticalExpand="True"
                              MinSize="700 0"
                              SeparationOverride="8">

                    <BoxContainer Orientation="Horizontal">
                        <Label Text="PROJECTOR MAP"
                               HorizontalExpand="True"
                               FontColorOverride="#e5e7eb"/>
                        <Label Name="ProjectorCountLabel"
                               Text=" No Same-Grid Projectors "
                               FontColorOverride="#7dd3fc"/>
                    </BoxContainer>

                    <PanelContainer VerticalExpand="True" HorizontalExpand="True" MinSize="700 590">
                        <ui:HologramConsoleNavMapControl Name="NavMap"
                                                         HorizontalExpand="True"
                                                         VerticalExpand="True"
                                                         MinSize="700 590"/>

                        <PanelContainer Name="NoServerOverlay"
                                        HorizontalExpand="True"
                                        VerticalExpand="True">
                            <BoxContainer Orientation="Vertical"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SeparationOverride="8">
                                <Label Name="NoServerMapLabel"
                                       Text="NO SAME-GRID PROJECTORS"
                                       HorizontalAlignment="Center"
                                       FontColorOverride="#ef4444"/>
                                <Label Text="Select a blade server and a projector on this grid."
                                       HorizontalAlignment="Center"
                                       FontColorOverride="#94a3b8"/>
                            </BoxContainer>
                        </PanelContainer>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
