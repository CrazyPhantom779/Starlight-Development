<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client._Starlight.AutoMod.UI.AutoModWindow"
               Title="AutoMod"
               MinSize="900 620">
    <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="8">
        <Label Name="StatusLabel" Text="AutoMod" />

        <BoxContainer Orientation="Horizontal" SeparationOverride="8" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" MinWidth="180" SeparationOverride="4" VerticalExpand="True">
                <Button Name="DashboardButton" Text="Dashboard" />
                <Button Name="IncidentsButton" Text="Incident Log" />
                <Button Name="ApprovalsButton" Text="Approval Queue" />
                <Button Name="PlayersButton" Text="Player Lookup" />
                <Button Name="RulesButton" Text="Rules" />
                <Button Name="TesterButton" Text="Tester" />
                <Button Name="DiscordButton" Text="Discord Logs" />
                <Button Name="HealthButton" Text="Sync / Health" />
                <Button Name="SettingsButton" Text="Settings" />
            </BoxContainer>

            <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="MainContent" Orientation="Vertical" SeparationOverride="4" Margin="8" HorizontalExpand="True" VerticalExpand="True">
                    <Label Name="MainTitle" Text="Dashboard" StyleClasses="LabelHeading" />
                    <RichTextLabel Name="MainText" VerticalExpand="True" HorizontalExpand="True" />
                    <LineEdit Name="TesterInput" PlaceHolder="Tester message" Visible="False" HorizontalExpand="True" />
                    <Button Name="RunTesterButton" Text="Run Tester" Visible="False" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
